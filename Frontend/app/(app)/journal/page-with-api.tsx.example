"use client"

import { useEffect, useState } from "react"
import { useForm } from "react-hook-form"
import { zodResolver } from "@hookform/resolvers/zod"
import * as z from "zod"
import { useBaby } from "@/contexts/baby-context"
import { journalService } from "@/lib/api-services"
import { formatDate, formatRelativeTime } from "@/lib/date-utils"
import { MOOD_COLORS } from "@/lib/constants"
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { Textarea } from "@/components/ui/textarea"
import { Label } from "@/components/ui/label"
import { Badge } from "@/components/ui/badge"
import { JournalSkeleton } from "@/components/loading-skeleton"
import { toast } from "sonner"
import { Smile, Meh, Frown, AlertCircle, Zap, Plus, Trash2, Edit } from "lucide-react"
import type { JournalEntry } from "@/lib/types"

const journalSchema = z.object({
  content: z.string().min(10, "Journal entry must be at least 10 characters"),
  mood: z.enum(["happy", "neutral", "sad", "anxious", "stressed"]),
})

type JournalFormData = z.infer<typeof journalSchema>

const moodOptions = [
  { value: "happy", label: "Happy", icon: Smile, color: MOOD_COLORS.happy },
  { value: "neutral", label: "Neutral", icon: Meh, color: MOOD_COLORS.neutral },
  { value: "sad", label: "Sad", icon: Frown, color: MOOD_COLORS.sad },
  { value: "anxious", label: "Anxious", icon: AlertCircle, color: MOOD_COLORS.anxious },
  { value: "stressed", label: "Stressed", icon: Zap, color: MOOD_COLORS.stressed },
]

export default function JournalPage() {
  const { selectedBaby } = useBaby()
  const [journals, setJournals] = useState<JournalEntry[]>([])
  const [isLoading, setIsLoading] = useState(true)
  const [isSubmitting, setIsSubmitting] = useState(false)
  const [editingId, setEditingId] = useState<string | null>(null)

  const {
    register,
    handleSubmit,
    watch,
    reset,
    setValue,
    formState: { errors },
  } = useForm<JournalFormData>({
    resolver: zodResolver(journalSchema),
    defaultValues: {
      mood: "neutral",
      content: "",
    },
  })

  const selectedMood = watch("mood")

  // Fetch journals
  useEffect(() => {
    if (!selectedBaby) return

    const fetchJournals = async () => {
      try {
        setIsLoading(true)
        const data = await journalService.getAll(selectedBaby.id)
        setJournals(data)
      } catch (error) {
        toast.error("Failed to load journal entries")
      } finally {
        setIsLoading(false)
      }
    }

    fetchJournals()
  }, [selectedBaby])

  // Create or update journal
  const onSubmit = async (data: JournalFormData) => {
    if (!selectedBaby) return

    try {
      setIsSubmitting(true)

      if (editingId) {
        // Update existing journal
        const updated = await journalService.update(editingId, data)
        setJournals(journals.map(j => j.id === editingId ? updated : j))
        toast.success("Journal entry updated!")
        setEditingId(null)
      } else {
        // Create new journal
        const newJournal = await journalService.create({
          ...data,
          babyId: selectedBaby.id,
          date: new Date().toISOString(),
        })
        setJournals([newJournal, ...journals])
        toast.success("Journal entry saved!")
      }

      reset()
    } catch (error) {
      toast.error("Failed to save journal entry")
    } finally {
      setIsSubmitting(false)
    }
  }

  // Edit journal
  const handleEdit = (journal: JournalEntry) => {
    setEditingId(journal.id)
    setValue("content", journal.content)
    setValue("mood", journal.mood)
    window.scrollTo({ top: 0, behavior: "smooth" })
  }

  // Delete journal
  const handleDelete = async (id: string) => {
    if (!confirm("Are you sure you want to delete this journal entry?")) return

    try {
      await journalService.delete(id)
      setJournals(journals.filter(j => j.id !== id))
      toast.success("Journal entry deleted")
    } catch (error) {
      toast.error("Failed to delete journal entry")
    }
  }

  // Cancel editing
  const handleCancelEdit = () => {
    setEditingId(null)
    reset()
  }

  if (isLoading) {
    return <JournalSkeleton />
  }

  return (
    <div className="max-w-4xl mx-auto space-y-6">
      <div>
        <h1 className="text-2xl sm:text-3xl font-bold">Journal</h1>
        <p className="text-muted-foreground mt-1">
          Express your thoughts and feelings. We are here to listen.
        </p>
      </div>

      {/* Journal Entry Form */}
      <Card>
        <CardHeader>
          <CardTitle>{editingId ? "Edit Entry" : "New Entry"}</CardTitle>
        </CardHeader>
        <CardContent>
          <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
            {/* Mood Selection */}
            <div className="space-y-2">
              <Label>How are you feeling?</Label>
              <div className="grid grid-cols-2 sm:grid-cols-5 gap-2">
                {moodOptions.map((mood) => {
                  const Icon = mood.icon
                  const isSelected = selectedMood === mood.value
                  return (
                    <button
                      key={mood.value}
                      type="button"
                      onClick={() => setValue("mood", mood.value as any)}
                      className={`p-3 rounded-lg border-2 transition-all ${
                        isSelected
                          ? "border-primary bg-primary/10"
                          : "border-border hover:border-primary/50"
                      }`}
                    >
                      <Icon
                        className="w-6 h-6 mx-auto mb-1"
                        style={{ color: mood.color }}
                      />
                      <span className="text-xs font-medium">{mood.label}</span>
                    </button>
                  )
                })}
              </div>
              {errors.mood && (
                <p className="text-sm text-red-500">{errors.mood.message}</p>
              )}
            </div>

            {/* Content */}
            <div className="space-y-2">
              <Label htmlFor="content">Your thoughts</Label>
              <Textarea
                id="content"
                rows={6}
                placeholder="Write about your day, feelings, or anything on your mind..."
                {...register("content")}
                disabled={isSubmitting}
              />
              {errors.content && (
                <p className="text-sm text-red-500">{errors.content.message}</p>
              )}
            </div>

            {/* Actions */}
            <div className="flex gap-2">
              <Button type="submit" disabled={isSubmitting}>
                {isSubmitting ? "Saving..." : editingId ? "Update Entry" : "Save Entry"}
              </Button>
              {editingId && (
                <Button
                  type="button"
                  variant="outline"
                  onClick={handleCancelEdit}
                  disabled={isSubmitting}
                >
                  Cancel
                </Button>
              )}
            </div>
          </form>
        </CardContent>
      </Card>

      {/* Journal Entries List */}
      <div className="space-y-4">
        <h2 className="text-xl font-semibold">Your Entries</h2>
        {journals.length === 0 ? (
          <Card>
            <CardContent className="py-12 text-center">
              <Plus className="w-12 h-12 mx-auto mb-4 text-muted-foreground" />
              <p className="text-muted-foreground">
                No journal entries yet. Start writing to track your journey!
              </p>
            </CardContent>
          </Card>
        ) : (
          journals.map((journal) => {
            const mood = moodOptions.find(m => m.value === journal.mood)
            const MoodIcon = mood?.icon || Meh

            return (
              <Card key={journal.id}>
                <CardHeader>
                  <div className="flex items-start justify-between">
                    <div className="flex items-center gap-3">
                      <div
                        className="p-2 rounded-lg"
                        style={{ backgroundColor: `${mood?.color}20` }}
                      >
                        <MoodIcon
                          className="w-5 h-5"
                          style={{ color: mood?.color }}
                        />
                      </div>
                      <div>
                        <Badge variant="secondary">{mood?.label}</Badge>
                        <p className="text-sm text-muted-foreground mt-1">
                          {formatDate(journal.date)} • {formatRelativeTime(journal.createdAt)}
                        </p>
                      </div>
                    </div>
                    <div className="flex gap-2">
                      <Button
                        size="sm"
                        variant="ghost"
                        onClick={() => handleEdit(journal)}
                      >
                        <Edit className="w-4 h-4" />
                      </Button>
                      <Button
                        size="sm"
                        variant="ghost"
                        onClick={() => handleDelete(journal.id)}
                      >
                        <Trash2 className="w-4 h-4" />
                      </Button>
                    </div>
                  </div>
                </CardHeader>
                <CardContent>
                  <p className="text-sm leading-relaxed whitespace-pre-wrap">
                    {journal.content}
                  </p>
                  {journal.sentiment !== undefined && (
                    <div className="mt-4 pt-4 border-t">
                      <p className="text-xs text-muted-foreground">
                        Sentiment Score: {(journal.sentiment * 100).toFixed(0)}%
                      </p>
                    </div>
                  )}
                </CardContent>
              </Card>
            )
          })
        )}
      </div>
    </div>
  )
}
