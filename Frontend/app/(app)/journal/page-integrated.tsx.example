"use client"

import { useEffect, useState } from "react"
import { useForm } from "react-hook-form"
import { zodResolver } from "@hookform/resolvers/zod"
import * as z from "zod"
import { useBaby } from "@/contexts/baby-context"
import { journalService } from "@/lib/api-services"
import { formatDate, formatRelativeTime } from "@/lib/date-utils"
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { Textarea } from "@/components/ui/textarea"
import { Label } from "@/components/ui/label"
import { Badge } from "@/components/ui/badge"
import { Alert, AlertDescription } from "@/components/ui/alert"
import { JournalSkeleton } from "@/components/loading-skeleton"
import { toast } from "sonner"
import { Smile, Meh, Frown, AlertCircle, Zap, Plus, Trash2, AlertTriangle } from "lucide-react"
import type { JournalEntry, CreateJournalEntryRequest } from "@/lib/types"

const journalSchema = z.object({
  content: z.string().min(10, "Journal entry must be at least 10 characters").max(5000, "Maximum 5000 characters"),
  mood: z.string().optional(),
})

type JournalFormData = z.infer<typeof journalSchema>

const moodOptions = [
  { value: "happy", label: "Happy", icon: Smile },
  { value: "neutral", label: "Neutral", icon: Meh },
  { value: "anxious", label: "Anxious", icon: AlertCircle },
  { value: "tired", label: "Tired", icon: Frown },
  { value: "overwhelmed", label: "Overwhelmed", icon: Zap },
]

export default function JournalPage() {
  const { selectedBaby } = useBaby()
  const [journals, setJournals] = useState<JournalEntry[]>([])
  const [isLoading, setIsLoading] = useState(true)
  const [isSubmitting, setIsSubmitting] = useState(false)

  const {
    register,
    handleSubmit,
    watch,
    reset,
    setValue,
    formState: { errors },
  } = useForm<JournalFormData>({
    resolver: zodResolver(journalSchema),
    defaultValues: {
      mood: "neutral",
      content: "",
    },
  })

  const selectedMood = watch("mood")

  // Fetch journals
  useEffect(() => {
    if (!selectedBaby) return

    const fetchJournals = async () => {
      try {
        setIsLoading(true)
        // Get last 30 days of journals
        const endDate = new Date()
        const startDate = new Date()
        startDate.setDate(startDate.getDate() - 30)
        
        const data = await journalService.getAll(
          startDate.toISOString(),
          endDate.toISOString()
        )
        setJournals(data)
      } catch (error) {
        toast.error("Failed to load journal entries")
      } finally {
        setIsLoading(false)
      }
    }

    fetchJournals()
  }, [selectedBaby])

  // Create journal
  const onSubmit = async (data: JournalFormData) => {
    if (!selectedBaby) {
      toast.error("Please select a baby profile first")
      return
    }

    try {
      setIsSubmitting(true)

      const requestData: CreateJournalEntryRequest = {
        content: data.content,
        mood: data.mood,
        babyId: selectedBaby.id,
      }

      const newJournal = await journalService.create(requestData)
      setJournals([newJournal, ...journals])
      toast.success("Journal entry saved!")
      reset()
    } catch (error) {
      toast.error("Failed to save journal entry")
    } finally {
      setIsSubmitting(false)
    }
  }

  // Delete journal
  const handleDelete = async (id: string) => {
    if (!confirm("Are you sure you want to delete this journal entry?")) return

    try {
      await journalService.delete(id)
      setJournals(journals.filter(j => j.id !== id))
      toast.success("Journal entry deleted")
    } catch (error) {
      toast.error("Failed to delete journal entry")
    }
  }

  if (isLoading) {
    return <JournalSkeleton />
  }

  return (
    <div className="max-w-4xl mx-auto space-y-6">
      <div>
        <h1 className="text-2xl sm:text-3xl font-bold">Journal</h1>
        <p className="text-muted-foreground mt-1">
          Express your thoughts and feelings. We are here to listen.
        </p>
      </div>

      {/* Journal Entry Form */}
      <Card>
        <CardHeader>
          <CardTitle>New Entry</CardTitle>
        </CardHeader>
        <CardContent>
          <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
            {/* Mood Selection */}
            <div className="space-y-2">
              <Label>How are you feeling?</Label>
              <div className="grid grid-cols-2 sm:grid-cols-5 gap-2">
                {moodOptions.map((mood) => {
                  const Icon = mood.icon
                  const isSelected = selectedMood === mood.value
                  return (
                    <button
                      key={mood.value}
                      type="button"
                      onClick={() => setValue("mood", mood.value)}
                      className={`p-3 rounded-lg border-2 transition-all ${
                        isSelected
                          ? "border-primary bg-primary/10"
                          : "border-border hover:border-primary/50"
                      }`}
                    >
                      <Icon className="w-6 h-6 mx-auto mb-1" />
                      <span className="text-xs font-medium">{mood.label}</span>
                    </button>
                  )
                })}
              </div>
            </div>

            {/* Content */}
            <div className="space-y-2">
              <Label htmlFor="content">Your thoughts</Label>
              <Textarea
                id="content"
                rows={6}
                placeholder="Write about your day, feelings, or anything on your mind..."
                {...register("content")}
                disabled={isSubmitting}
              />
              {errors.content && (
                <p className="text-sm text-red-500">{errors.content.message}</p>
              )}
            </div>

            {/* Actions */}
            <Button type="submit" disabled={isSubmitting}>
              {isSubmitting ? "Saving..." : "Save Entry"}
            </Button>
          </form>
        </CardContent>
      </Card>

      {/* Journal Entries List */}
      <div className="space-y-4">
        <h2 className="text-xl font-semibold">Your Entries</h2>
        {journals.length === 0 ? (
          <Card>
            <CardContent className="py-12 text-center">
              <Plus className="w-12 h-12 mx-auto mb-4 text-muted-foreground" />
              <p className="text-muted-foreground">
                No journal entries yet. Start writing to track your journey!
              </p>
            </CardContent>
          </Card>
        ) : (
          journals.map((journal) => {
            const mood = moodOptions.find(m => m.value === journal.mood?.toLowerCase())
            const MoodIcon = mood?.icon || Meh

            return (
              <Card key={journal.id}>
                <CardHeader>
                  <div className="flex items-start justify-between">
                    <div className="flex items-center gap-3">
                      <div className="p-2 rounded-lg bg-primary/10">
                        <MoodIcon className="w-5 h-5" />
                      </div>
                      <div>
                        <div className="flex items-center gap-2">
                          <Badge variant="secondary">{journal.mood || 'No mood'}</Badge>
                          <Badge 
                            variant={
                              journal.sentiment === 'POSITIVE' ? 'default' :
                              journal.sentiment === 'NEGATIVE' ? 'destructive' :
                              'secondary'
                            }
                          >
                            {journal.sentiment}
                          </Badge>
                        </div>
                        <p className="text-sm text-muted-foreground mt-1">
                          {formatDate(journal.createdAt)} • {formatRelativeTime(journal.createdAt)}
                        </p>
                      </div>
                    </div>
                    <Button
                      size="sm"
                      variant="ghost"
                      onClick={() => handleDelete(journal.id)}
                    >
                      <Trash2 className="w-4 h-4" />
                    </Button>
                  </div>
                </CardHeader>
                <CardContent className="space-y-4">
                  <p className="text-sm leading-relaxed whitespace-pre-wrap">
                    {journal.content}
                  </p>

                  {/* Sentiment Scores */}
                  {journal.sentimentScores && (
                    <div className="grid grid-cols-4 gap-2 text-xs">
                      <div className="text-center p-2 rounded bg-green-50 dark:bg-green-950">
                        <div className="font-semibold text-green-700 dark:text-green-300">
                          {(journal.sentimentScores.positive * 100).toFixed(0)}%
                        </div>
                        <div className="text-muted-foreground">Positive</div>
                      </div>
                      <div className="text-center p-2 rounded bg-red-50 dark:bg-red-950">
                        <div className="font-semibold text-red-700 dark:text-red-300">
                          {(journal.sentimentScores.negative * 100).toFixed(0)}%
                        </div>
                        <div className="text-muted-foreground">Negative</div>
                      </div>
                      <div className="text-center p-2 rounded bg-gray-50 dark:bg-gray-950">
                        <div className="font-semibold">
                          {(journal.sentimentScores.neutral * 100).toFixed(0)}%
                        </div>
                        <div className="text-muted-foreground">Neutral</div>
                      </div>
                      <div className="text-center p-2 rounded bg-blue-50 dark:bg-blue-950">
                        <div className="font-semibold text-blue-700 dark:text-blue-300">
                          {(journal.sentimentScores.mixed * 100).toFixed(0)}%
                        </div>
                        <div className="text-muted-foreground">Mixed</div>
                      </div>
                    </div>
                  )}

                  {/* Red Flags Warning */}
                  {journal.hasRedFlags && journal.emergencyResources && (
                    <Alert variant="destructive">
                      <AlertTriangle className="h-4 w-4" />
                      <AlertDescription>
                        <p className="font-semibold mb-2">We noticed you might need support</p>
                        <div className="space-y-2">
                          {journal.emergencyResources.map((resource, idx) => (
                            <div key={idx} className="text-sm">
                              <p className="font-medium">{resource.name}</p>
                              <p>{resource.phone}</p>
                              <p className="text-xs">{resource.description}</p>
                            </div>
                          ))}
                        </div>
                      </AlertDescription>
                    </Alert>
                  )}
                </CardContent>
              </Card>
            )
          })
        )}
      </div>
    </div>
  )
}
